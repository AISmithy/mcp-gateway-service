# MCP Gateway Service Configuration
PORT=3000
ENV=development

# Downstream Service URLs
AUTH_BROKER_URL=http://auth-broker-service:8001
TOOL_REGISTRY_URL=http://tool-registry-service:8002
POLICY_GUARDRAIL_URL=http://policy-guardrail-service:8003
TOOL_ORCHESTRATOR_URL=http://tool-orchestrator-service:8004
AUDIT_TELEMETRY_URL=http://audit-telemetry-service:8005

# Auth
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=mcp-gateway

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
